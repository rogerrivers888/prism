# Static SPA served by Caddy. Railway supplies $PORT.
:{$PORT:8080} {
	root * dist
	encode gzip zstd

	# Hashed asset filenames are immutable; index.html must never be cached
	# or a deploy leaves clients pinned to a stale bundle.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# Client-side routing: unknown paths are React Router's problem, not 404s.
	try_files {path} /index.html
	file_server
}
